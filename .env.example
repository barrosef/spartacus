# ─── GCP / Firebase ───────────────────────────────────────────────────────────
# ID do projeto GCP (usado em dev local e CI/CD)
FIREBASE_PROJECT_ID=spartacus-prod

# Credenciais de SA — apenas em produção fora do Cloud Run.
# No Cloud Run, as credenciais são providas automaticamente pela SA vinculada.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── Dev local (Docker Compose / direto no host) ──────────────────────────────
# Aponte para os Firebase Emulators ao rodar localmente.
# Descomente ao rodar o backend fora do Docker Compose.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ─── Firebase Tools (necessário para o emulador dentro do Docker) ─────────────
# Gere em: https://firebase.google.com/docs/cli#sign-in-test-cli
# FIREBASE_TOKEN=
