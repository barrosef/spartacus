# ─── GCP / Firebase ───────────────────────────────────────────────────────────
# ID do projeto GCP.
# Dev local: use "demo-spartacus" (projeto fictício, sem cobrança, sem acesso GCP real).
# Produção (CI/CD): use o ID real do projeto GCP.
FIREBASE_PROJECT_ID=demo-spartacus

# Em dev local, deve ser igual a FIREBASE_PROJECT_ID para que o Firebase Admin SDK
# e os emuladores usem o mesmo projeto. Em produção, não definir (usa ADC do Cloud Run).
GOOGLE_CLOUD_PROJECT=demo-spartacus

# Credenciais de SA — apenas em produção fora do Cloud Run.
# No Cloud Run, as credenciais são providas automaticamente pela SA vinculada.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── Dev local (Docker Compose / direto no host) ──────────────────────────────
# Aponte para os Firebase Emulators ao rodar localmente.
# Descomente ao rodar o backend fora do Docker Compose.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ─── Firebase Tools (necessário para o emulador dentro do Docker) ─────────────
# Gere em: https://firebase.google.com/docs/cli#sign-in-test-cli
# FIREBASE_TOKEN=

# ─── Backend — Logging ────────────────────────────────────────────────────────
# Nível de log do backend. Usar "info" em produção, "debug" em dev/staging.
# Em debug, parâmetros de métodos (exceto campos sensíveis) são incluídos nos logs.
# NUNCA usar "debug" em produção — risco de expor PII em payloads.
LOG_LEVEL=info

# ─── MailerSend (e-mails transacionais) ──────────────────────────────────────
# Obtenha em: MailerSend Console → API Tokens
# Em produção: armazenado no GCP Secret Manager (não defina aqui)
MAILERSEND_API_KEY=

# Habilita o endpoint POST /internal/email/test (apenas em dev local)
APP_ENV=development

# ─── Frontend (Vite — backoffice web) ─────────────────────────────────────────
# URL da API (Cloud Run em prod, localhost em dev)
VITE_API_URL=http://localhost:8000

# Configuração do Firebase SDK para o frontend.
# Obtenha em: Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=spartacus-artes-marciais.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spartacus-artes-marciais
VITE_FIREBASE_STORAGE_BUCKET=spartacus-artes-marciais.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
